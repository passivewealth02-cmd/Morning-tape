# Anthropic API (for AI ticket categorization)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (optional — powers the "Generate image" button in Design Autopilot Coach)
# Uses gpt-image-1 for transparent-background PNGs. Without this the coach still
# works; the image button just shows a "copy the prompt into your own tool" message.
OPENAI_API_KEY=sk-...
# Optional overrides:
# COACH_IMAGE_MODEL=gpt-image-1
# COACH_IMAGE_BASE_URL=https://api.openai.com/v1

# Neon Database (PostgreSQL)
DATABASE_URL=postgresql://...

# Resend Email
RESEND_API_KEY=re_...

# Vercel Blob (for ticket file/photo uploads)
# Auto-provisioned when you create a Blob store in the Vercel dashboard
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# App URL
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Cron secret (protects the SLA-check cron endpoint; Vercel Cron sends it as a Bearer token)
CRON_SECRET=generate-a-long-random-string
